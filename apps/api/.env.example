# Copie para .env e preencha com os valores reais (o .env NÃO vai para o Git).

# MySQL no formato do Prisma. Com o Aiven, troque o "?ssl-mode=REQUIRED" da
# Service URI pelo final abaixo, que verifica o certificado do servidor com a
# CA pública do projeto (prisma/aiven-ca.pem). O caminho do sslcert é relativo
# à pasta prisma/. É o formato usado na Vercel e em Linux.
#
# No macOS o final abaixo falha com "P1011: The certificate was not trusted":
# o certificado do Aiven não tem a extensão ExtendedKeyUsage, que o TLS da Apple
# exige. Para rodar a API ou o prisma migrate no Mac, use
# "?sslaccept=accept_invalid_certs", que aceita o certificado sem verificar.
DATABASE_URL="mysql://usuario:senha@host:3306/defaultdb?sslcert=./aiven-ca.pem&sslaccept=strict"

# Segredos dos tokens JWT. Gere valores aleatórios, por exemplo:
#   openssl rand -hex 32
JWT_SECRET="troque-por-um-valor-aleatorio"
JWT_REFRESH_SECRET="troque-por-outro-valor-aleatorio"

# Origem da web liberada no CORS (em produção, a URL da Vercel da web).
# http://localhost:5173 é sempre liberado em desenvolvimento.
WEB_ORIGIN="http://localhost:5173"

PORT=3000
