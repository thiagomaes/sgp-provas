@startuml
title Diagrama de Classes do SGP — schema Prisma N2
skinparam classAttributeIconSize 0
hide empty members

class Professor {
  +id : String
  +nome : String
  +email : String
  +passwordHash : String
  +createdAt : DateTime
  +anonymizedAt : DateTime?
}

class RefreshToken {
  +id : String
  +professorId : String
  +tokenHash : String
  +expiresAt : DateTime
  +revokedAt : DateTime?
  +createdAt : DateTime
}

class Turma {
  +id : String
  +professorId : String
  +nome : String
  +disciplina : String
  +ano : String
  +turno : String
  +createdAt : DateTime
}

class Aluno {
  +id : String
  +turmaId : String
  +nome : String
  +matricula : String
  +createdAt : DateTime
}

class Questao {
  +id : String
  +professorId : String
  +enunciado : String
  +tipo : String
  +respostaEsperada : String?
  +pontuacaoMaxima : Float?
  +disciplina : String
  +tags : Json
  +deletedAt : DateTime?
  +criadaEm : DateTime
}

class Alternativa {
  +id : String
  +questaoId : String
  +letra : String
  +texto : String
  +correta : Boolean
}

class Prova {
  +id : String
  +professorId : String
  +titulo : String
  +disciplina : String
  +totalPontos : Float
  +criadaEm : DateTime
  +deletedAt : DateTime?
}

class ProvaQuestao {
  +id : String
  +provaId : String
  +questaoId : String
  +ordem : Int
  +pontuacao : Float
}

class Aplicacao {
  +id : String
  +provaId : String
  +turmaId : String
  +professorId : String
  +data : DateTime
  +versoes : Int
  +embaralharQuestoes : Boolean
  +embaralharAlternativas : Boolean
  +identificarAluno : Boolean
  +status : String
  +corrigidas : Int
  +createdAt : DateTime
}

class VersaoProva {
  +id : String
  +aplicacaoId : String
  +numeroVersao : Int
  +layout : Json
  +qrCodePayload : String
  +createdAt : DateTime
}

class Correcao {
  +id : String
  +aplicacaoId : String
  +alunoId : String?
  +versao : Int
  +nota : Float
  +respostas : Json
  +origem : String
  +clientCorrectionId : String
  +statusSync : String
  +corrigidaEm : DateTime
}

Professor "1" -- "0..*" RefreshToken : possui
Professor "1" -- "0..*" Turma : cadastra
Professor "1" -- "0..*" Questao : cadastra
Professor "1" -- "0..*" Prova : cria
Professor "1" -- "0..*" Aplicacao : registra
Turma "1" -- "0..*" Aluno : contem
Turma "1" -- "0..*" Aplicacao : recebe
Questao "1" -- "0..*" Alternativa : possui
Questao "1" -- "0..*" ProvaQuestao : selecionada em
Prova "1" -- "0..*" ProvaQuestao : organiza
Prova "1" -- "0..*" Aplicacao : aplicada em
Aplicacao "1" -- "0..*" VersaoProva : gera
Aplicacao "1" -- "0..*" Correcao : recebe
Aluno "0..1" -- "0..*" Correcao : identificado em
@enduml
